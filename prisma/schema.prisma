generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SheetCategory {
  einnahmen
  ausgaben
  sonstiges
}

model AccountingProfile {
  id           String            @id
  name         String
  passwordHash String            @map("password_hash")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  sheets       AccountingSheet[]
  backups      AccountingBackup[]

  @@map("accounting_profiles")
}

model AccountingSheet {
  id        String            @id
  profileId String            @map("profile_id")
  name      String
  category  SheetCategory
  color     String
  columns   Json              @default("[]")
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  profile   AccountingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rows      AccountingRow[]

  @@unique([profileId, id])
  @@index([profileId])
  @@map("accounting_sheets")
}

model AccountingRow {
  profileId String          @map("profile_id")
  sheetId   String          @map("sheet_id")
  rowId     Int             @map("row_id")
  datum     String
  values    Json            @default("{}")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  sheet     AccountingSheet @relation(fields: [profileId, sheetId], references: [profileId, id], onDelete: Cascade)

  @@id([profileId, rowId])
  @@unique([profileId, sheetId, rowId])
  @@index([profileId, sheetId])
  @@index([profileId, sheetId, sortOrder])
  @@map("accounting_rows")
}

model AccountingBackup {
  id        String            @id
  profileId String            @map("profile_id")
  label     String?
  snapshot  Json
  sheetCount Int              @default(0) @map("sheet_count")
  rowCount   Int              @default(0) @map("row_count")
  createdAt DateTime          @default(now()) @map("created_at")
  profile   AccountingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("accounting_backups")
}
